# Environment
NODE_ENV=production

# API base path
VITE_API_BASE_PATH=

# Build base path
VITE_BASE_PATH=/vue-element-plus-admin/

# Whether to drop debugger statements
VITE_DROP_DEBUGGER=true

# Whether to drop console.log calls
VITE_DROP_CONSOLE=true

# Whether to generate sourcemaps
VITE_SOURCEMAP=false

# Output directory
VITE_OUT_DIR=dist-pro

# App title
VITE_APP_TITLE=Scope Sentry
