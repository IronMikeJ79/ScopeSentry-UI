# Environment
NODE_ENV=production

# API base path
VITE_API_BASE_PATH=/api

# Build base path
VITE_BASE_PATH=/dist-dev/

# Whether to drop debugger statements
VITE_DROP_DEBUGGER=false

# Whether to drop console.log calls
VITE_DROP_CONSOLE=false

# Whether to generate sourcemaps
VITE_SOURCEMAP=true

# Output directory
VITE_OUT_DIR=dist-dev
VITE_USE_MOCK=false
# App title
VITE_APP_TITLE=Scope Sentry
